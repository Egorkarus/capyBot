# Токен вашего бота (получите на Discord Developer Portal: https://discord.com/developers/applications)
DISCORD_TOKEN=ваштестовыйтокен

# Опционально: уровень логирования (info, error)
LOG_LEVEL=info

# ========================================
# Security & Performance Configuration
# ========================================

# HTTP Download Timeout (milliseconds)
# Максимальное время ожидания при скачивании прямых аудиофайлов
# HTTP_DOWNLOAD_TIMEOUT_MS=60000

# yt-dlp Process Timeout (milliseconds)
# Максимальное время работы процесса yt-dlp (стриминг или загрузка)
# YT_DLP_TIMEOUT_MS=90000

# Maximum File Size (bytes)
# Максимальный размер загружаемого файла (по умолчанию 100 МБ)
# MAX_FILE_SIZE_BYTES=104857600

# Maximum Tracks Per Guild
# Максимальное количество треков в очереди на один сервер
# MAX_TRACKS_PER_GUILD=50

# Maximum Tracks Per User
# Максимальное количество треков от одного пользователя в очереди
# MAX_TRACKS_PER_USER=10

# Play Rate Limit Window (milliseconds)
# Окно времени для ограничения частоты команды !play
# PLAY_RATE_LIMIT_WINDOW_MS=60000

# Max Play Requests Per Window
# Максимальное количество команд !play от пользователя за окно времени
# MAX_PLAY_REQUESTS_PER_WINDOW=5
